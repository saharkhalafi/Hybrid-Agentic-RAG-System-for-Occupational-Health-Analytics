# ============================================
# Google Cloud Configuration
# ============================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# Optional — uses ADC when unset
# GOOGLE_APPLICATION_CREDENTIALS=service-account.json

# ============================================
# Google Cloud Storage
# ============================================
GCS_BUCKET_NAME=your-bucket-name
GCS_RAW_FOLDER=raw
GCS_PROCESSED_FOLDER=processed

# ============================================
# PostgreSQL
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=ohse_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5434/ohse_intelligence

# ============================================
# Vector Database
# ============================================
ENABLE_PGVECTOR=true
# Must match your embedding model output dimension (NOT hardcoded in code)
VECTOR_DIMENSION=3072

# ============================================
# LLM Layer
# ============================================
GOOGLE_API_KEY=your_gemini_api_key
LLM_MODEL=gemini-2.5-pro

# ============================================
# Embedding Model
# ============================================
EMBEDDING_MODEL=gemini-embedding-001

# ============================================
# Document Processing
# ============================================
OCR_LANGUAGE_CODES=fa,en
OCR_DPI=300
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ============================================
# Application
# ============================================
ENVIRONMENT=development
LOG_LEVEL=INFO
